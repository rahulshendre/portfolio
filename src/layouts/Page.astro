---
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/400-italic.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/silkscreen/400.css';
import '../styles/global.css';
import { site, nav, credits } from '../data/site';
import github from '../data/github.json';

interface Props {
  title?: string;
  description?: string;
  /** Pages without the editorial chrome (the game) pass bare. */
  bare?: boolean;
}
const { title, description = site.description, bare = false } = Astro.props;
const fullTitle = title ? `${title} · ${site.name}` : `${site.name}: ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const snapshot = new Date(github.generatedAt).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1c1a17" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={site.links.xHandle} />
    <meta name="twitter:creator" content={site.links.xHandle} />
    <slot name="head" />
    <script is:inline>
      // Shown inside the garage's panel? Drop the site chrome (the panel has its own bar) and keep the game from loading inside itself.
      if (window.top !== window.self) {
        document.documentElement.classList.add('embedded');
        document.addEventListener('click', function (e) {
          var a = e.target && e.target.closest && e.target.closest('a[href]');
          if (!a) return;
          var u = new URL(a.href, location.href);
          if (u.origin !== location.origin) { a.target = '_blank'; a.rel = 'noopener'; return; }
          if (u.pathname === '/') { e.preventDefault(); window.parent.postMessage({ rs: 'close-panel' }, location.origin); }
        }, true);
      }
    </script>
  </head>
  <body>
    {bare ? <slot /> : (
      <>
        <header class="site-header">
          <div class="wrap">
            <a class="garage-link" href="/?garage">← GARAGE</a>
            <a class="site-name" href="/list">{site.name}</a>
            <nav class="site-nav" aria-label="Sections">
              {nav.map((n) => <a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>)}
            </nav>
          </div>
        </header>
        <main class="wrap"><slot /></main>
        <footer class="site-footer">
          <div class="wrap">
            <span>{site.name} · {site.location}</span>
            <ul>
              <li><a href={site.links.github}>GitHub</a></li>
              <li><a href={site.links.x}>X {site.links.xHandle}</a></li>
              <li><a href={site.links.linkedin}>LinkedIn</a></li>
              <li><a href={`mailto:${site.email}`}>Email</a></li>
              <li><a href="/list">Everything</a></li>
            </ul>
            <span class="mono">GitHub data as of {snapshot}</span>
            <p class="credits mono">{credits.map((c) => <>{c.what}: <a href={c.url}>{c.title}</a> by {c.author}, <a href={c.licenceUrl}>{c.licence}</a>; {c.changes}.</>)}</p>
          </div>
        </footer>
      </>
    )}
  </body>
</html>
