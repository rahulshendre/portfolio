---
import Page from '../layouts/Page.astro';
import { site, nav } from '../data/site';
---
<Page bare description={site.description}>
  <a class="skip-plain" href="/list">Skip the game: plain version</a>
  <h1 class="sr-only">{site.name}: {site.tagline}</h1>
  <div class="viewport" id="viewport">
    <div class="stage" id="stage">
      <canvas id="game" aria-label="Pixel-art game: ride a white Scrambler down an Indian highway to Rahul's garage. Every object in the garage links to a section of the site."></canvas>
      <nav class="hotspots" id="hotspots" aria-label="Garage"></nav>
    </div>
  </div>
  <div class="term" id="term" hidden>
    <div class="term-win" role="dialog" aria-modal="true" aria-label="Garage terminal">
      <div class="term-bar"><span>RS-OS · GARAGE TERMINAL</span><button type="button" class="term-close" aria-label="Close terminal">ESC</button></div>
      <div class="term-out" aria-live="polite"></div>
      <form class="term-form" autocomplete="off"><label for="term-in">&gt;</label><input id="term-in" type="text" spellcheck="false" autocapitalize="off" aria-label="Type a command, for example help" /></form>
    </div>
  </div>
  <div class="panel" id="panel" hidden>
    <div class="panel-win" role="dialog" aria-modal="true" aria-labelledby="panel-title">
      <div class="panel-bar"><span id="panel-title"></span><a class="panel-full" id="panel-full" href="/list" target="_top">FULL PAGE</a><button type="button" class="panel-close" aria-label="Close panel">ESC</button></div>
      <iframe id="panel-frame" title="Section from the garage"></iframe>
    </div>
  </div>
  <button type="button" class="sound" id="sound" aria-pressed="true">SOUND ON</button>
  <div class="sky" id="sky" hidden>
    <button type="button" id="sky-weather" aria-label="Change the weather outside the window">SKY: CLEAR</button>
    <button type="button" id="sky-theme" aria-label="Change the view from the window">VIEW: HIMALAYA</button>
  </div>
  <div class="phone-bar" aria-hidden="true">
    <a href="/list" tabindex="-1">LIST</a>
    <button type="button" id="phone-term" tabindex="-1">TERMINAL</button>
    <a href="/?ride" tabindex="-1">RIDE AGAIN</a>
  </div>
  <nav class="sr-only" aria-label="Sections">
    <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}<li><a href="/list">Everything on one page</a></li></ul>
  </nav>
  <noscript>
    <div class="noscript">
      <h2>{site.name}</h2>
      <p>{site.description}</p>
      <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
      <p><a href="/list">Everything on one page</a></p>
    </div>
  </noscript>
  <style is:global>
    html, body { height: 100%; overflow: hidden; background: #1b1712; }
    .viewport { position: fixed; inset: 0; display: grid; place-items: center; overflow: hidden; }
    .viewport:has(.stage[data-mode='world']), .viewport:has(.stage[data-mode='wide']) { overflow-x: auto; overflow-y: hidden; justify-items: safe center; overscroll-behavior-x: contain; }
    .stage { position: relative; flex: none; opacity: 0; }
    .viewport.ready .stage { opacity: 1; transition: opacity 0.35s; }
    /* Until the first frame is painted: the garage as a still, so the page is never a blank box and nothing shifts. */
    .viewport::before { content: ''; position: absolute; inset: 0; background: #1b1712 url('/sprites/poster.png') center / contain no-repeat; image-rendering: pixelated; transition: opacity 0.35s; }
    .viewport.ready::before { opacity: 0; pointer-events: none; }
    .sound { position: fixed; top: 8px; left: 8px; z-index: 6; border: 0; cursor: pointer; font: 400 12px/1 'Silkscreen', monospace; background: #1b1712; color: #fff6e0; padding: 9px 11px; box-shadow: 3px 3px 0 #e8b923; }
    .sky { position: fixed; top: 8px; left: 118px; z-index: 6; display: flex; gap: 10px; }
    .sky[hidden] { display: none; }
    .sky button { border: 0; cursor: pointer; font: 400 12px/1 'Silkscreen', monospace; background: #1b1712; color: #fff6e0; padding: 9px 11px; box-shadow: 3px 3px 0 #e8b923; }
    .sky button:focus-visible { outline: 3px solid #e8b923; outline-offset: 2px; }
    @media (max-width: 900px), (pointer: coarse) { .sky { display: none; } } /* on phones the buttons would cover the garage: the window still changes the weather */
    .sound[aria-pressed='false'] { color: #a89d8b; box-shadow: 3px 3px 0 #6b5518; }
    .sound:focus-visible { outline: 3px solid #e8b923; outline-offset: 2px; }
    .stage canvas { display: block; width: 100%; height: 100%; image-rendering: pixelated; touch-action: none; }
    .stage[data-mode='world'] canvas, .stage[data-mode='wide'] canvas { touch-action: pan-x; }
    .stage canvas.fx { position: absolute; inset: 0; pointer-events: none; }
    .hotspots { position: absolute; inset: 0; pointer-events: none; }
    .hotspots a:hover, .hotspots a:focus { background: none; } /* the canvas draws the highlight; the site-wide link tint would cover the art */
    .hotspots a { position: absolute; pointer-events: auto; display: block; cursor: pointer; border-radius: 2px; }
    .hotspots a img { position: absolute; inset: 6% 5%; width: 90%; height: 88%; object-fit: contain; image-rendering: pixelated; pointer-events: none; transition: filter 0.3s; }
    .hotspots[data-night] a img { filter: brightness(0.45); }
    @media (pointer: coarse) { /* a bigger invisible tap area on touch: at least 44px, but growing by no more than 6px a side so packed objects barely overlap */
      .hotspots a::after, .hotspots button::after { content: ''; position: absolute; left: 50%; top: 50%; width: 100%; height: 100%; min-width: min(44px, calc(100% + 12px)); min-height: min(44px, calc(100% + 12px)); transform: translate(-50%, -50%); }
    }
    .hotspots a:focus-visible { outline: 3px solid #e8b923; outline-offset: 2px; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .skip-plain { position: fixed; left: 8px; top: 8px; z-index: 10; transform: translateY(-200%); background: #e8b923; color: #1b1712; padding: 8px 12px; font: 600 14px/1 system-ui; }
    .skip-plain:focus { transform: none; }
    /* In the garage on a portrait phone the in-world bar buttons sit off-screen: mirror them here. */
    .phone-bar { display: none; position: fixed; left: 8px; right: 8px; bottom: 8px; justify-content: space-between; pointer-events: none; z-index: 5; }
    .phone-bar a, .phone-bar button { pointer-events: auto; border: 0; cursor: pointer; font: 400 12px/1 'Silkscreen', monospace; background: #1b1712; color: #fff6e0; padding: 10px 12px; text-decoration: none; box-shadow: 3px 3px 0 #e8b923; }
    @media (orientation: portrait) { body:has(.stage[data-mode='world']) .phone-bar { display: flex; } }
    .stage { transform-origin: 50% 60%; will-change: transform; }
    .viewport.zooming { overflow: hidden !important; }
    .hotspots button { position: absolute; pointer-events: auto; display: block; cursor: pointer; border: 0; background: none; padding: 0; border-radius: 2px; }
    .hotspots button:focus-visible { outline: 3px solid #e8b923; outline-offset: 2px; }
    .term { position: fixed; inset: 0; z-index: 8; display: grid; place-items: center; background: rgba(10, 8, 5, 0.55); padding: 12px; }
    .term[hidden] { display: none; }
    .term-win { width: min(640px, 100%); height: min(420px, 78vh); display: flex; flex-direction: column; background: #0d1a12; color: #b8f0c0; border: 3px solid #cfc8b8; border-radius: 10px; box-shadow: 0 0 0 3px #1b1712, 0 18px 50px #000a, inset 0 0 60px #0a2a16; font: 15px/1.45 ui-monospace, Menlo, Consolas, monospace; text-shadow: 0 0 6px #4be08a66; position: relative; overflow: hidden; }
    .term-win::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(0deg, #0000 0 2px, #0004 2px 3px); }
    .term-bar { display: flex; justify-content: space-between; align-items: center; padding: 6px 10px; background: #143222; font-size: 12px; letter-spacing: .08em; }
    .term-close { font: inherit; color: #0d1a12; background: #b8f0c0; border: 0; padding: 2px 8px; cursor: pointer; }
    .term-close:focus-visible, .term-out a:focus-visible { outline: 2px solid #e8b923; outline-offset: 2px; }
    .term-out { flex: 1; overflow-y: auto; padding: 10px 12px; white-space: pre-wrap; overflow-wrap: anywhere; }
    .term-out > * { display: block; }
    .term-out a { color: #ffe08a; text-decoration: underline; text-underline-offset: 3px; }
    .term-out .dim { color: #6fae85; }
    .term-out .err { color: #ff9a8a; }
    .term-out .ok { color: #ffe08a; }
    .term-form { display: flex; gap: 8px; padding: 8px 12px 10px; border-top: 1px solid #1f4a30; }
    .term-form input { flex: 1; min-width: 0; background: transparent; border: 0; outline: 0; color: inherit; font: inherit; text-shadow: inherit; caret-color: #b8f0c0; }
    @media (prefers-reduced-motion: no-preference) {
      .term { animation: term-dim .3s ease-out both; }
      .term-win { animation: term-on .18s ease-out .22s both; } /* after the camera has pushed in on the TV */
    }
    @keyframes term-dim { from { background: rgba(10, 8, 5, 0); } }
    @keyframes term-on { from { transform: scaleY(.04); opacity: .4; } to { transform: none; opacity: 1; } }
    .panel { position: fixed; inset: 0; z-index: 9; display: grid; place-items: center; background: rgba(10, 8, 5, 0.6); padding: 14px; }
    .panel[hidden] { display: none; }
    .panel-win { width: min(980px, 100%); height: min(90vh, 880px); display: flex; flex-direction: column; background: #f4efe6; border: 4px solid #1b1712; border-radius: 0; box-shadow: 0 0 0 4px #e8b923, 0 0 0 8px #1b1712, 12px 12px 0 8px #0009; overflow: hidden; /* a hard pixel frame like the garage's own: square corners, a gold rim, a stepped block shadow */ }
    .panel-bar { display: flex; align-items: center; gap: 14px; padding: 8px 12px; background: #1b1712; color: #fff6e0; font: 12px/1 'Silkscreen', monospace; letter-spacing: .06em; }
    .panel-bar span { flex: 1; }
    .panel-full { color: #e8b923; text-decoration: none; }
    .panel-full:hover, .panel-full:focus-visible { text-decoration: underline; background: none; }
    .panel-close { font: inherit; color: #1b1712; background: #e8b923; border: 0; padding: 4px 9px; cursor: pointer; }
    .panel-close:focus-visible, .panel-full:focus-visible { outline: 2px solid #fff6e0; outline-offset: 2px; }
    .panel iframe { flex: 1; width: 100%; border: 0; background: #f4efe6; }
    @media (max-width: 720px) { .panel { padding: 0; } .panel-win { height: 100%; border-radius: 0; border-width: 0; } }
    @media (prefers-reduced-motion: no-preference) {
      .panel { animation: term-dim .3s ease-out both; }
      .panel-win { transform-origin: var(--ox, 50%) var(--oy, 50%); animation: panel-in .3s cubic-bezier(.2, .9, .3, 1) both; } /* grows out of the object you clicked */
    }
    @keyframes panel-in { from { transform: scale(.4); opacity: 0; } }
    .noscript { position: fixed; inset: 0; overflow: auto; background: #f4efe6; color: #1b1712; padding: 2rem; font: 18px/1.6 system-ui; z-index: 20; }
  </style>
  <script>
    import '../game/main.ts';
  </script>
</Page>
